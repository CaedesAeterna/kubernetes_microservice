<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %> - Media Tracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">Media Tracker</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/media">Browse</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/library">My Library</a></li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/profile">Hi, <%= username %></a></li>
                    <li class="nav-item"><a class="nav-link" href="/auth/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>My Library</h1>
            <div class="d-flex">
                <input type="text" id="librarySearch" class="form-control me-3" placeholder="Filter my library..." onkeyup="filterLibrary()">
                <a href="/library/history" class="btn btn-info text-white me-2" style="white-space: nowrap;">Global History</a>
                <a href="/media" class="btn btn-success" style="white-space: nowrap;">+ Browse & Add Media</a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0" id="libraryTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th>Rating</th>
                            <th>Update</th>
                            <th>History</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% library.forEach(function(item) { %>
                            <tr>
                                <form action="/library/update" method="POST">
                                    <input type="hidden" name="id" value="<%= item.id %>">
                                    <td class="align-middle fw-bold title-cell"><%= item.media_title %></td>
                                    <td class="align-middle"><span class="badge bg-info text-dark"><%= item.media_type %></span></td>
                                    <td>
                                        <select name="status" class="form-select form-select-sm">
                                            <option value="Plan to Watch" <%= item.status === 'Plan to Watch' ? 'selected' : '' %>>Plan to Watch</option>
                                            <option value="Watching" <%= item.status === 'Watching' ? 'selected' : '' %>>Watching/Reading</option>
                                            <option value="Completed" <%= item.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                                            <option value="Dropped" <%= item.status === 'Dropped' ? 'selected' : '' %>>Dropped</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" name="progress" value="<%= item.progress %>" class="form-control form-control-sm" placeholder="Ep 1 / Ch 5">
                                    </td>
                                    <td>
                                        <input type="number" name="rating" value="<%= item.rating %>" min="1" max="10" class="form-control form-control-sm" style="width: 70px;">
                                    </td>
                                    <td>
                                        <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                    </td>
                                    <td>
                                        <a href="/library/history?title=<%= encodeURIComponent(item.media_title) %>" class="btn btn-sm btn-outline-secondary">Log</a>
                                    </td>
                                </form>
                            </tr>
                        <% }); %>
                        <% if (library.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center p-5">
                                    <p class="text-muted">Your library is empty.</p>
                                    <a href="/media" class="btn btn-primary">Go Add Something!</a>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <script>
        function filterLibrary() {
            var input, filter, table, tr, td, i, txtValue;
            input = document.getElementById("librarySearch");
            filter = input.value.toUpperCase();
            table = document.getElementById("libraryTable");
            tr = table.getElementsByTagName("tr");

            for (i = 0; i < tr.length; i++) {
                td = tr[i].getElementsByClassName("title-cell")[0];
                if (td) {
                    txtValue = td.textContent || td.innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }
    </script>
</body>
</html>